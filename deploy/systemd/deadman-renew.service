[Unit]
Description=Renew Freqtrade ICICI Breeze Deadman Lease
After=network.target

[Service]
Type=oneshot
User=trader
WorkingDirectory=/home/trader/work/freqtrade-icicibreeze
ExecStart=/usr/bin/python3 scripts/ops/p41_deadman_renew.py
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
